    {
      "id": "S6-02-secret-bcrypt-mutation",
      "purpose": "In-place bcrypt mutation of remote-management.secret-key at startup (B21, section 3.3.1) + plaintext remains the accepted management key.",
      "classification": "RECORDABLE-LOCALLY",
      "preconditions": "FRESH config copy (NOT the current fleet config, whose secret is already hashed): identical to fleet config but remote-management.secret-key set to PLAINTEXT \"oracle-mgmt-key-1\". Mount as config.yaml, start container, wait for startup log line.",
      "steps": [
        {
          "n": 1,
          "transport": "disk",
          "capture": "config.yaml BEFORE container start (bytes)"
        },
        {
          "n": 2,
          "transport": "wait",
          "until": "docker log line 'API server started successfully' (or equivalent); then sleep 2s for the write-back"
        },
        {
          "n": 3,
          "transport": "disk",
          "capture": "config.yaml AFTER startup (bytes)"
        },
        {
          "n": 4,
          "transport": "http",
          "method": "GET",
          "path": "/v0/management/api-keys",
          "headers": {
            "Authorization: Bearer oracle-mgmt-key-1": ""
          },
          "body": null,
          "expect": "200 with the plaintext key still accepted"
        }
      ],
      "record": {
        "http": "status+headers+body for step 4",
        "disk": [
          "config.yaml before",
          "config.yaml after"
        ]
      },
      "dynamic_fields": [
        "bcrypt hash value (random salt; keep the $2a$10$ + 53-char tail structure in the fixture, mask the tail)",
        "Date"
      ],
      "mock_upstream": null,
      "determinism": "Only the hash string varies. Assert: after == before except the secret-key line; after line matches ^[ \\t]*secret-key: *\"?\\$2[aby]\\$10\\$[./A-Za-z0-9]{53}\"?$; step 4 returns 200 proving plaintext still valid."
    },
