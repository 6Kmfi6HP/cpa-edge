    {
      "id": "S6-07-usage-resp-protocol",
      "purpose": "RESP command surface on the management port: NOAUTH, AUTH ok/bad, LPOP/RPOP frames, unsupported channel, unknown command, QUIT (B18, section 4).",
      "classification": "RECORDABLE-LOCALLY",
      "preconditions": "Same container as S6-05 (usage-statistics-enabled true). Before the RESP steps, produce exactly 2 mock chat completions via HTTP (same request as S6-05 step 1, twice) so the queue holds exactly 2 records. Mock openai happy.",
      "steps": [
        {
          "n": 1,
          "transport": "resp",
          "conn": 1,
          "send": "*2\r\n$4\r\nLPOP\r\n$5\r\nusage\r\n",
          "expect": "-NOAUTH Authentication required.\r\n"
        },
        {
          "n": 2,
          "transport": "resp",
          "conn": 2,
          "send": "*2\r\n$4\r\nAUTH\r\n$12\r\nwrong-key-123\r\n",
          "expect": "-ERR invalid management key\r\n"
        },
        {
          "n": 3,
          "transport": "resp",
          "conn": 3,
          "send": "*2\r\n$4\r\nAUTH\r\n$16\r\noracle-mgmt-key-1\r\n",
          "expect": "+OK\r\n"
        },
        {
          "n": 4,
          "transport": "resp",
          "conn": 3,
          "send": "*3\r\n$4\r\nLPOP\r\n$5\r\nusage\r\n$2\r\n10\r\n",
          "expect": "*2 + two bulk strings (oldest first), byte-exact RESP"
        },
        {
          "n": 5,
          "transport": "resp",
          "conn": 3,
          "send": "*2\r\n$4\r\nLPOP\r\n$5\r\nusage\r\n",
          "expect": "$-1\r\n (empty)"
        },
        {
          "n": 6,
          "transport": "resp",
          "conn": 3,
          "send": "*3\r\n$4\r\nRPOP\r\n$5\r\nusage\r\n$1\r\n1\r\n",
          "expect": "$-1\r\n (RPOP reads the same head; empty now)"
        },
        {
          "n": 7,
          "transport": "resp",
          "conn": 3,
          "send": "*3\r\n$4\r\nLPOP\r\n$6\r\nerrors\r\n$1\r\n1\r\n",
          "expect": "-ERR unsupported channel 'errors'\r\n"
        },
        {
          "n": 8,
          "transport": "resp",
          "conn": 3,
          "send": "*1\r\n$3\r\nFOO\r\n",
          "expect": "-ERR unknown command 'foo'\r\n"
        },
        {
          "n": 9,
          "transport": "resp",
          "conn": 3,
          "send": "*1\r\n$4\r\nQUIT\r\n",
          "expect": "+OK\r\n then server closes"
